      <trans-unit id="dashboard.welcome.description" datatype="html">
        <source> Stork is a monitoring solution for <x id="START_EMPHASISED_TEXT" ctype="x-em" equiv-text="&lt;em&gt;" />ISC Kea DHCP<x id="CLOSE_EMPHASISED_TEXT" ctype="x-em" equiv-text="&lt;/em&gt;" /> and <x id="START_EMPHASISED_TEXT" ctype="x-em" equiv-text="&lt;em&gt;" />ISC BIND 9<x id="CLOSE_EMPHASISED_TEXT" ctype="x-em" equiv-text="&lt;/em&gt;" />. It also integrates with the third-party <x id="START_EMPHASISED_TEXT" ctype="x-em" equiv-text="&lt;em&gt;" />PowerDNS<x id="CLOSE_EMPHASISED_TEXT" ctype="x-em" equiv-text="&lt;/em&gt;" /> server. </source>
        <context-group purpose="location">
          <context context-type="sourcefile">src/app/dashboard/dashboard.component.html</context>
          <context context-type="linenumber">12,14</context>
        </context-group>
      <target state="translated"> Stork är en övervakningslösning för <x id="START_EMPHASISED_TEXT" ctype="x-em" equiv-text="&lt;em&gt;" />ISC Kea DHCP<x id="CLOSE_EMPHASISED_TEXT" ctype="x-em" equiv-text="&lt;/em&gt;" /> och <x id="START_EMPHASISED_TEXT" ctype="x-em" equiv-text="&lt;em&gt;" />ISC BIND 9<x id="CLOSE_EMPHASISED_TEXT" ctype="x-em" equiv-text="&lt;/em&gt;" />. Den kan även integreras med tredjepartsservern <x id="START_EMPHASISED_TEXT" ctype="x-em" equiv-text="&lt;em&gt;" />PowerDNS<x id="CLOSE_EMPHASISED_TEXT" ctype="x-em" equiv-text="&lt;/em&gt;" />. </target></trans-unit>
